<!-- app/views/test_passages/result.html.erb -->
<% color =  @test_passage.successful? ? "#0ED002" : "#FC0221"%>
<h1><%= t('.header', title: @test_passage.test.title) %></h1>
<p>
  <%= t('test_passages.result.percentage') %> <strong style="color:<%= color %>" ><%= @test_passage.percentage_completion %> %</strong><br>
</p>

<%= link_to t('all_tests'), tests_path, class: "text-decoration-none" %>
